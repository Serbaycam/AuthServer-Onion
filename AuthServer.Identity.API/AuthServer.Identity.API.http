@host = https://localhost:7023
# Supply credentials locally; never commit real passwords or bearer tokens.
@email =
@password =
@accessToken =
@refreshToken =

POST {{host}}/api/auth/login
Content-Type: application/json

{"email":"{{email}}","password":"{{password}}"}

###
POST {{host}}/api/auth/refresh-token
Content-Type: application/json

{"refreshToken":"{{refreshToken}}"}

###
POST {{host}}/api/auth/revoke-token
Content-Type: application/json

{"token":"{{refreshToken}}"}

###
GET {{host}}/api/usermanagement/all-users
Authorization: Bearer {{accessToken}}
